{
  "name": "@luism/adt-ts",
  "version": "0.1.0",
  "description": "Lightweight, tree-shakable TypeScript library for Algebraic Data Types (Option, Result, Task, ADT)",
  "keywords": [
    "adt",
    "algebraic-data-types",
    "either",
    "functional-programming",
    "maybe",
    "option",
    "result",
    "tagged-union",
    "task",
    "typescript"
  ],
  "license": "MIT",
  "author": "Luis Middleton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismiddleton/adt-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./option": {
      "types": "./dist/esm/option.d.ts",
      "import": "./dist/esm/option.js",
      "require": "./dist/cjs/option.cjs"
    },
    "./result": {
      "types": "./dist/esm/result.d.ts",
      "import": "./dist/esm/result.js",
      "require": "./dist/cjs/result.cjs"
    },
    "./task": {
      "types": "./dist/esm/task.d.ts",
      "import": "./dist/esm/task.js",
      "require": "./dist/cjs/task.cjs"
    },
    "./adt": {
      "types": "./dist/esm/adt.d.ts",
      "import": "./dist/esm/adt.js",
      "require": "./dist/cjs/adt.cjs"
    }
  },
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "build:doc": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:stage": "pnpm build && npm stage publish",
    "ci:publish": "pnpm build && pnpm publish --access=public --no-git-checks --provenance",
    "ci:publish:github": "pnpm publish --registry=https://npm.pkg.github.com --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@microsoft/api-extractor": "^7.52.11",
    "@rslib/core": "^0.12.4",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typedoc": "^0.28.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
